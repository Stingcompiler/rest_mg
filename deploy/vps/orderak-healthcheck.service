# Orderak health check (batch 39). Script: deploy/vps/orderak-healthcheck.sh.
[Unit]
Description=Orderak health check (service, site, backups; Telegram alert on failure)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/sbin/orderak-healthcheck
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/orderak
