# Orderak web service (installed as /etc/systemd/system/orderak-web.service).
# Each release has its own venv (batch 50): `current` switches code and
# packages together, so a rollback brings back both.
[Unit]
Description=Orderak (Django monolith: API + exported web) on 127.0.0.1:8200
After=network.target postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
User=orderak
Group=orderak
WorkingDirectory=/opt/orderak/current/api
EnvironmentFile=/opt/orderak/env
ExecStart=/opt/orderak/current/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8200 --workers 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/orderak/media

[Install]
WantedBy=multi-user.target
